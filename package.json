{
  "name": "openquest",
  "private": true,
  "version": "0.1.0",
  "description": "Open-source quests that lock you out until you touch grass.",
  "license": "Apache-2.0",
  "scripts": {
    "dev:pwa": "pnpm --filter @openquest/pwa dev",
    "dev:worker": "pnpm --filter @openquest/worker dev",
    "dev": "pnpm run dev:pwa",
    "build:pwa": "pnpm --filter @openquest/pwa build",
    "build:worker": "pnpm --filter @openquest/worker build",
    "build": "pnpm run build:pwa",
    "test": "pnpm -r --if-present test",
    "lint": "pnpm -r --if-present lint",
    "typecheck": "pnpm -r --if-present typecheck"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "prettier": "^3.9.10"
  },
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=22.12"
  }
}
